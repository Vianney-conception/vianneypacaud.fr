Options -Indexes
ErrorDocument 404 /Articles/404.php
ErrorDocument 403 /Articles/403.php

<IfModule mod_rewrite.c>
    RewriteEngine On
    RewriteBase /

    RewriteCond %{HTTP_HOST} ^(www\.)?gervo\.org$ [NC]
    RewriteCond %{REQUEST_URI} !^/Gervo(/|$)
    RewriteRule ^(.*)$ /Gervo/$1 [L]

    RewriteCond %{REQUEST_FILENAME} !-d
    RewriteCond %{REQUEST_FILENAME}.php -f
    RewriteRule ^(.*)$ $1.php [L]

    RewriteCond %{REQUEST_FILENAME} !-d
    RewriteCond %{REQUEST_FILENAME}.html -f
    RewriteRule ^(.*)$ $1.html [L]
</IfModule>